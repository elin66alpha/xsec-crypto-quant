# ===== 复制为 .env 后填入真实值，.env 永不入库 =====

# --- OKX（永续合约数据 + paper trading）---
# 历史 OHLCV/funding 走公共接口，无需 key；以下仅 paper trading（阶段6）私有接口需要。
# 注意 OKX 私有接口除 key/secret 外还需 passphrase。
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# --- CoinGecko / CoinMarketCap（历史市值快照，用于动态池构建）---
# 二选一，取决于 data/universe.py 的数据源实现
COINGECKO_API_KEY=your_coingecko_api_key_here
# CMC_API_KEY=your_coinmarketcap_api_key_here

# ===== 可调参数（也可改放配置文件，此处给默认值便于本地覆盖）=====

# --- 动态池（决策 1）---
UNIVERSE_TOP_N=30                 # 每月按成交额选 Top N
UNIVERSE_MIN_LISTING_DAYS=90      # 要求上市满 N 天
UNIVERSE_VOLUME_LOOKBACK_DAYS=30  # 成交额回看窗口

# --- 数据 ---
DATA_DIR=./data
BAR_INTERVAL=1d                   # 日频

# --- 回测数据切分（决策见 CLAUDE.md 阶段 5）---
INSAMPLE_START=2020-01-01
INSAMPLE_END=2022-12-31
VALIDATION_START=2023-01-01
VALIDATION_END=2023-12-31
# HOLDOUT 起始日由解锁时确定，不在此预设，避免反复试探

# --- 风控红线（决策 8，硬约束，代码中应再次裁剪，不依赖此处）---
MAX_LEVERAGE_PER_SIDE=1.0
MAX_GROSS_LEVERAGE=2.0

# --- 成本假设（决策 4，宁可偏高）---
TAKER_FEE_RATE=0.0005             # OKX 永续 Taker 0.05%（普通等级）
SLIPPAGE_TICKS=1

# --- 监控告警（阶段 6）---
DAILY_DRAWDOWN_ALERT=0.03
CONSECUTIVE_LOSS_PAUSE=5
DATA_OUTAGE_ALERT_MINUTES=5
